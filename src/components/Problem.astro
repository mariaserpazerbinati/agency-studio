---
import { problem } from "../data/site";
---

{/* Sta fra hero e servizi di proposito: nomina ciò che il visitatore già vive,
    così l'elenco che segue si legge come risposta e non come catalogo. */}
<section
  id="problema"
  class="border-t border-[var(--color-border)] bg-[var(--color-bg-alt)]/50 px-5 py-24 sm:px-8 sm:py-32"
>
  <div class="mx-auto max-w-7xl">
    {/* Colonna singola con rientro: la domanda a piena larghezza, il testo
        che rientra sulla destra. Ogni altra sezione è a due colonne
        affiancate — qui il ritmo è diagonale, e si distingue. */}
    <h2
      class="problem-item font-display max-w-[19ch] text-balance text-[2.4rem] font-normal leading-[1.02] tracking-display text-[var(--color-fg)] sm:text-5xl lg:text-[4.2rem]"
    >
      {problem.domanda}
    </h2>

    <div class="problem-item mt-12 lg:mt-16 lg:pl-[38%]">
      <p class="max-w-[52ch] text-lg leading-relaxed text-[var(--color-fg)] sm:text-xl">
        {problem.testo}
      </p>

      <p
        class="font-display mt-8 max-w-[34ch] text-balance border-t border-[var(--color-border)] pt-6 text-xl font-normal leading-snug tracking-display text-[var(--color-fg)] sm:text-[1.75rem]"
      >
        {problem.ponte}
      </p>
    </div>
  </div>
</section>

<style>
  .problem-item {
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 0.8s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .problem-item.is-visible {
    opacity: 1;
    transform: none;
  }

  /* il testo entra dopo la domanda: prima si legge, poi si spiega */
  .problem-item.is-visible:nth-child(2) {
    transition-delay: 0.14s;
  }

  @media (prefers-reduced-motion: reduce) {
    .problem-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const parti = document.querySelectorAll<HTMLElement>(".problem-item");

  if (parti.length) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.35 }
    );

    parti.forEach((p) => observer.observe(p));
  }
</script>
