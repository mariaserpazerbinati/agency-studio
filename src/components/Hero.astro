---
import { hero } from "../data/site";
---

<section
  id="home"
  class="relative flex h-svh min-h-[600px] w-full items-end overflow-hidden bg-[var(--color-bg)]"
>
  <video
    id="hero-video"
    class="absolute inset-0 h-full w-full object-cover"
    poster="/images/hero/hero-poster.jpg"
    muted
    loop
    playsinline
    preload="none"
    width="1920"
    height="1080"
    aria-hidden="true"
  >
    <source data-src="/videos/hero.webm" type="video/webm" />
    <source data-src="/videos/hero.mp4" type="video/mp4" />
  </video>

  <div class="hero-veil pointer-events-none absolute inset-0"></div>

  <div class="relative z-10 w-full px-5 pb-20 sm:px-8 sm:pb-28">
    <div class="mx-auto max-w-7xl">
      <h1
        class="font-display max-w-4xl text-balance text-[11vw] font-normal leading-[1.02] tracking-display text-[var(--color-ink-fg)] sm:text-[7vw] lg:text-[5.5vw]"
      >
        {hero.headline}
      </h1>
      {/* max-w calibrata per far cadere il sottotitolo su due righe */}
      <p class="mt-6 max-w-[62ch] text-xl leading-snug text-[var(--color-ink-fg)] sm:text-2xl">
        {hero.subheadline}
      </p>
    </div>
  </div>

  <div
    class="absolute bottom-6 right-5 z-10 flex items-center gap-2 text-xs uppercase tracking-widest text-[var(--color-fg-muted)] sm:right-8"
  >
    <span class="h-8 w-px animate-pulse bg-[var(--color-fg-muted)]"></span>
    Scroll
  </div>
</section>

<style>
  /* Velo tarato sull'inquadratura del Duomo: nella fascia del testo c'è una
     copertura vetrata quasi bianca (luminosità 230/255) che col testo avorio
     dava 1:1, cioè invisibile. Serve quindi un velo deciso, ma confinato:
     sopra il 58% il fotogramma resta del tutto scoperto.
     Contrasto misurato nel caso peggiore: 7,38:1. */
  /* Velo scuro, concentrato in basso: il testo è avorio, quindi serve
     abbassare la luminosità del video solo dove il testo appoggia.
     Sopra il 55% dell'altezza il video resta del tutto scoperto. */
  .hero-veil {
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.86) 0%,
      rgb(0 0 0 / 0.78) 18%,
      rgb(0 0 0 / 0.70) 34%,
      rgb(0 0 0 / 0.24) 48%,
      transparent 58%
    );
  }
</style>

<script>
  const section = document.getElementById("home");
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;

  if (section && video) {
    let sourcesLoaded = false;

    const loadSources = () => {
      if (sourcesLoaded) return;
      sourcesLoaded = true;
      video.querySelectorAll("source[data-src]").forEach((source) => {
        source.setAttribute("src", source.getAttribute("data-src") ?? "");
      });
      video.load();
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadSources();
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.25 }
    );

    observer.observe(section);
  }
</script>
