---
import { stats } from "../data/site";
---

<section
  id="risultati"
  class="border-t border-[var(--color-border)] px-5 py-24 sm:px-8 sm:py-32"
>
  <div class="mx-auto max-w-7xl">
    <h2 class="font-body mb-16 text-base font-light uppercase tracking-[0.2em] text-[var(--color-fg-muted)]">
      Risultati
    </h2>

    <dl class="grid grid-cols-2 gap-x-8 gap-y-14 lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div>
            <dt class="sr-only">{stat.label}</dt>
            <dd
              class="count-up font-display text-5xl font-light tracking-display text-[var(--color-fg)] sm:text-6xl lg:text-7xl"
              data-target={stat.value}
              data-suffix={stat.suffix}
            >
              {stat.value.toLocaleString("it-IT")}{stat.suffix}
            </dd>
            <p class="mt-3 text-base text-[var(--color-fg-muted)] sm:text-lg">{stat.label}</p>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const counters = document.querySelectorAll<HTMLElement>(".count-up[data-target]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  const format = (value: number, suffix: string) =>
    `${value.toLocaleString("it-IT")}${suffix}`;

  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.target ?? "0");
    const suffix = el.dataset.suffix ?? "";
    const duration = 2200;
    const start = performance.now();

    const tick = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      // Decelerazione quadratica: più dolce della cubica, così anche su
      // numeri a due cifre il conteggio attraversa ogni valore.
      const eased = 1 - Math.pow(1 - progress, 2);
      el.textContent = format(Math.round(target * eased), suffix);
      if (progress < 1) requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  };

  // L'HTML contiene già il valore finale, così senza JS (o con moto ridotto)
  // i numeri sono comunque corretti. Solo se animiamo li azzeriamo:
  // succede fuori campo, prima che la sezione entri in vista.
  if (counters.length && !reduced.matches) {
    counters.forEach((el) => {
      el.textContent = format(0, el.dataset.suffix ?? "");
    });

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );

    counters.forEach((counter) => observer.observe(counter));
  }
</script>
