---
import { Image } from "astro:assets";
import { nav, site } from "../data/site";
import logo from "../assets/brand/logo.png";
---

<div id="nav-sentinel" class="absolute top-0 h-px w-full" aria-hidden="true"></div>

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-transparent transition-colors duration-300"
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8">
    <a href="#home" class="flex shrink-0 items-center">
      {/* L'alt porta il nome: sostituendo il testo con un'immagine, senza di esso
          il collegamento resterebbe senza nome per lettori di schermo e motori. */}
      <Image
        src={logo}
        alt={site.name}
        height={28}
        densities={[1, 2]}
        loading="eager"
        class="h-6 w-auto sm:h-7"
      />
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        nav.slice(1).map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-light text-[var(--color-fg-muted)] transition-colors hover:text-[var(--color-accent)] lg:text-base"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="#contatti"
      class="hidden rounded-full border border-[var(--color-border)] px-4 py-2 text-sm font-light text-[var(--color-fg)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] md:inline-block lg:text-base"
    >
      Parliamone
    </a>

    <button
      id="nav-toggle"
      type="button"
      class="relative z-50 flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
      aria-label="Apri il menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="nav-bar h-0.5 w-6 bg-[var(--color-fg)] transition-transform duration-300"></span>
      <span class="nav-bar h-0.5 w-6 bg-[var(--color-fg)] transition-opacity duration-300"></span>
      <span class="nav-bar h-0.5 w-6 bg-[var(--color-fg)] transition-transform duration-300"></span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-0 z-40 flex translate-x-full flex-col justify-center gap-8 bg-[var(--color-bg)] px-8 transition-transform duration-300 ease-out md:hidden"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="mobile-link font-display text-3xl font-semibold tracking-display text-[var(--color-fg)]"
        >
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<style>
  #site-nav.is-scrolled {
    background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(10px);
  }

  #mobile-menu.is-open {
    transform: translateX(0);
    pointer-events: auto;
  }

  #nav-toggle[aria-expanded="true"] .nav-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #nav-toggle[aria-expanded="true"] .nav-bar:nth-child(2) {
    opacity: 0;
  }
  #nav-toggle[aria-expanded="true"] .nav-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>

<script>
  const sentinel = document.getElementById("nav-sentinel");
  const header = document.getElementById("site-nav");

  if (sentinel && header) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle("is-scrolled", !entry.isIntersecting);
      },
      { threshold: 0, rootMargin: "-1px 0px 0px 0px" }
    );
    observer.observe(sentinel);
  }

  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle && menu) {
    const closeMenu = () => {
      menu.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      document.body.classList.remove("overflow-hidden");
    };

    const openMenu = () => {
      menu.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
      document.body.classList.add("overflow-hidden");
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      isOpen ? closeMenu() : openMenu();
    });

    menu.querySelectorAll(".mobile-link").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });
  }
</script>
